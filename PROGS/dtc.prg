FUNCTION dtc

PARAMETERS tcDigi

DO case
CASE VAL(tcDigi)=1
    RETURN "一"
    
CASE VAL(tcDigi)=2
    RETURN "二"

CASE VAL(tcDigi)=3
    RETURN "三"
    
CASE VAL(tcDigi)=4
    RETURN "四"
    
CASE VAL(tcDigi)=5
    RETURN "五"
    
CASE VAL(tcDigi)=6
    RETURN "六"
    
CASE VAL(tcDigi)=7
    RETURN "七"
    
CASE VAL(tcDigi)=8
    RETURN "八"
    
CASE VAL(tcDigi)=9
    RETURN "九"
    
CASE VAL(tcDigi)=10
    RETURN "十"
    
CASE VAL(tcDigi)=11
    RETURN "十一"
    
CASE VAL(tcDigi)=12
    RETURN "十二"
    
CASE VAL(tcDigi)=13
    RETURN "十三"
    
CASE VAL(tcDigi)=14
    RETURN "十四"
    
CASE VAL(tcDigi)=15
    RETURN "十五"
    
CASE VAL(tcDigi)=16
    RETURN "十六"

CASE VAL(tcDigi)=17
    RETURN "十七"
    
CASE VAL(tcDigi)=18
    RETURN "十八"

CASE VAL(tcDigi)=19
    RETURN "十九"

CASE VAL(tcDigi)=20
    RETURN "二十"

CASE VAL(tcDigi)=21
    RETURN "二十一"

CASE VAL(tcDigi)=22
    RETURN "二十二"

CASE VAL(tcDigi)=23
    RETURN "二十三"

CASE VAL(tcDigi)=24
    RETURN "二十四"

CASE VAL(tcDigi)=25
    RETURN "二十五"

CASE VAL(tcDigi)=26
    RETURN "二十六"

CASE VAL(tcDigi)=27
    RETURN "二十七"

OTHERWISE
    RETURN "      "
ENDCASE